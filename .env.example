# ============================================================
# 図面くん (Zumen-kun) - 環境変数設定
# cp .env.example .env してから編集してください
# ============================================================

# ============================================================
# ローカル Supabase 設定（Docker で自動生成される値）
# docker-compose up --build で http://localhost:8000 が起動
# ============================================================

# PostgreSQL パスワード（お好みで変更可）
POSTGRES_PASSWORD=your-super-secret-password

# JWT Secret（32文字以上。お好みで変更可）
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ローカル Supabase API URL（変更不要）
SUPABASE_URL=http://localhost:8000

# ============================================================
# Supabase JWTトークン（ローカル開発用デフォルト値）
# ※ 本番環境では必ず新しいシークレットを生成してください
# ============================================================

# Anon Key（フロントエンド公開用・読み取りのみ）
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7kyqTsaDuzuTa4gCbxpHZHpO-pVCq44RBoY

# Service Role Key（バックエンド用・全権限）
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ============================================================
# Go Backend / Python Worker 用（Docker内部通信）
# ============================================================
SUPABASE_KEY=${SERVICE_ROLE_KEY}

# ============================================================
# Next.js フロントエンド用（外部アクセスURL）
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=${ANON_KEY}

# ============================================================
# AI サービス設定（任意 - 未設定時はモック動作）
# ============================================================

# OpenAI APIキー（PDF解析用）
# https://platform.openai.com/api-keys から取得
OPENAI_API_KEY=sk-your-openai-api-key-here

# Retell AI 設定（自動物確電話用）
# https://www.retellai.com から取得
RETELL_API_KEY=your-retell-api-key-here
RETELL_AGENT_ID=your-agent-id-here

# ============================================================
# Redis 設定（変更不要）
# ============================================================
REDIS_URL=redis://redis:6379

# ============================================================
# その他設定
# ============================================================
GO_PORT=8080
GO_ENV=development
PYTHON_LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase Studio アクセスURL（変更不要）
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
